es ab dir trotzen:"],[41.53,43.695,"Siegfried","kaum das Reden h\u00e4tt\u2019 ich erraten,"],[43.695,45.44,"Siegfried","entwandt ich\u2019s mit Gewalt nicht dem Schuft!"],[46.135,47.872,"Siegfried","Heraus damit, r\u00e4udiger Kerl!"],[48.85,50.54,"Siegfried","Wer ist mir Vater und Mutter?"],[50.735,52.77,"Mime","Ans Leben gehst du mir schier!"],[53.123,55.229,"Siegfried","Den Namen sollst du mir nennen!"],[56.471,58.742,"Mime","Entfiel er mir wohl? Doch halt!"],[60.023,62.362,"Mime","Sieglinde mochte sie hei\u00dfen,"],[63.352,66.609,"Mime","die dich in Sorge mir gab: \u2013"],[67.075,72.581,"Mime","\u00abich h\u00fctete dich wie die eig\u2019ne Haut\u00bb \u2013"],[72.581,76.681,"Siegfried","Dann frag\u2019 ich, wie hie\u00df mein Vater?"],[76.837,78.509,"Mime","Den hab\u2019 ich nie gesehn!"],[78.806,81.674,"Siegfried","Doch die Mutter nannte den Namen?"],[82.403,84.923,"Mime","Erschlagen sei er, das sagte sie nur: \u2013"]],"notes":[[0.0,0.0551,72,110,0],[0.0,0.7546,60,110,1],[0.0,0.7546,64,110,1],[0.0,0.7546,76,110,0],[0.185,0.0551,72,110,0],[0.37,0.0551,67,110,0],[0.555,0.0551,69,109,0],[0.74,0.74,70,109,0],[0.74,0.7551,55,109,1],[0.74,0.7551,63,109,1],[0.74,0.7551,75,109,0],[1.48,0.057,70,107,0],[1.48,0.7801,58,107,1],[1.48,0.7801,62,107,1],[1.48,0.7801,74,107,0],[1.6712,0.057,70,107,0],[1.8625,0.057,65,107,0],[2.0538,0.057,67,106,0],[2.245,0.765,68,106,0],[2.245,0.7799,53,106,1],[2.245,0.7799,61,106,1],[2.245,0.7799,73,106,0],[3.01,0.0562,68,104,0],[3.01,0.7699,56,104,1],[3.01,0.7699,60,104,1],[3.01,0.7699,72,104,0],[3.1988,0.0562,68,104,0],[3.3875,0.0562,63,104,0],[3.5762,0.0562,65,103,0],[3.765,0.7169,58,103,1],[3.765,0.7728,61,103,0],[3.765,0.7728,66,103,0],[3.765,0.7728,70,103,0],[4.52,0.067,48,101,1],[4.52,0.9178,60,101,0],[4.52,0.9178,65,101,0],[4.52,0.9178,68,101,0],[4.745,0.067,48,101,1],[4.97,0.067,44,101,1],[5.195,0.067,46,100,1],[5.42,0.067,48,100,1],[5.42,0.427,58,100,0],[5.42,0.427,64,100,0],[5.42,0.427,67,100,0],[5.645,0.067,48,100,1],[5.87,0.